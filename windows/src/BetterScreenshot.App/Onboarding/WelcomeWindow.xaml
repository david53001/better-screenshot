<Window x:Class="BetterScreenshot.App.Onboarding.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to BetterScreenshot"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Theme.WindowBrush}" FontFamily="Segoe UI"
        Foreground="{StaticResource Theme.TextBrush}">
    <Grid>
    <StackPanel Margin="36,32,36,28" VerticalAlignment="Center">

        <!-- App icon: charcoal rounded square with a white camera glyph (hand-authored vector) -->
        <Border Width="72" Height="72" CornerRadius="16" Background="#1C1C1C"
                BorderBrush="{StaticResource Theme.BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
            <Canvas Width="72" Height="72">
                <Rectangle Canvas.Left="30" Canvas.Top="20" Width="12" Height="6" RadiusX="2" RadiusY="2" Fill="#F5F5F5"/>
                <Border Canvas.Left="18" Canvas.Top="26" Width="36" Height="26" CornerRadius="6" Background="#F5F5F5"/>
                <Ellipse Canvas.Left="28" Canvas.Top="31" Width="16" Height="16" Fill="#1C1C1C"/>
            </Canvas>
        </Border>

        <TextBlock Text="Welcome to BetterScreenshot" FontSize="19" FontWeight="Bold"
                   Margin="0,18,0,0" HorizontalAlignment="Center"/>
        <TextBlock x:Name="TrayBlurb" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Theme.SecondaryTextBrush}" Margin="0,8,0,0"
                   Text="A free, 100% local screenshot &amp; recording tool that lives in your system tray — no cloud, no accounts."/>

        <Border x:Name="ShortcutsCard"
                Background="#14FFFFFF" CornerRadius="10" Margin="0,18,0,0" Padding="16,12">
            <StackPanel x:Name="ShortcutRows"/>
        </Border>

        <!-- Tours question (Mac v3 §7.1 Step 2): only for a new user who hasn't answered, in place of Start Capturing. -->
        <StackPanel x:Name="QuestionBlock" Visibility="Collapsed" Margin="0,20,0,0">
            <Rectangle Height="1" Width="300" Fill="{StaticResource Theme.BorderBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="Want a quick tour?" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            <TextBlock Text="We'll point out each part the first time you use it. You can skip any time."
                       FontSize="13" Foreground="{StaticResource Theme.SecondaryTextBrush}" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="NoThanksButton" Content="No Thanks" IsCancel="True" Click="NoThanks_Click"
                        Padding="0,9" FontSize="14" Cursor="Hand"/>
                <Button x:Name="ShowMeButton" Grid.Column="2" Content="Show Me Around" Click="ShowMe_Click"
                        Style="{StaticResource Theme.AccentButton}" Padding="0,9" FontSize="14" Cursor="Hand"/>
            </Grid>
        </StackPanel>

        <Button x:Name="StartButton" Content="Start Capturing" IsDefault="True" Click="Start_Click"
                Style="{StaticResource Theme.AccentButton}"
                Margin="0,20,0,0" Padding="0,9" FontSize="14" Cursor="Hand"/>
    </StackPanel>
    <ContentPresenter x:Name="InfoSlot" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"/>
    </Grid>
</Window>
