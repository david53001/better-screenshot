<Window x:Class="BetterScreenshot.App.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Annotate" Width="1100" Height="720" MinWidth="884" MinHeight="440"
        WindowStartupLocation="Manual" Background="{DynamicResource Ed.WindowBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="600"/>
                <ColumnDefinition x:Name="PanelColumn" Width="284"/>
            </Grid.ColumnDefinitions>

            <!-- Canvas column: tool pill centred over it, zoomable canvas below -->
            <Grid x:Name="CanvasColumn">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="ToolPill" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="6"
                        CornerRadius="15" Background="{DynamicResource Panel.SurfaceBrush}"
                        BorderBrush="{StaticResource Ed.HairlineBrush}" BorderThickness="1">
                    <StackPanel x:Name="Toolbar" Orientation="Horizontal"/>
                </Border>
                <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="0,6,0,0" Focusable="False"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="StageHost" Margin="24,20,24,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="Stage" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="StageScale" ScaleX="1" ScaleY="1"/>
                            </Grid.LayoutTransform>
                            <Image x:Name="CanvasImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Canvas x:Name="InteractionLayer" Background="Transparent" ClipToBounds="False"/>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Border x:Name="PanelHost" Grid.Column="1" Margin="8,12,12,12"/>
        </Grid>

        <!-- Bottom bar: hint line + action row -->
        <Border Grid.Row="1" Background="{StaticResource Ed.BarBrush}" BorderBrush="{StaticResource Ed.HairlineBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="16,9,16,0" VerticalAlignment="Top">
                    <ContentControl x:Name="HintIcon" Width="13" Height="13" Margin="0,1,6,0" Focusable="False"/>
                    <TextBlock x:Name="HintText" FontSize="12" Foreground="{StaticResource Ed.SecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <DockPanel Margin="16,0,16,8" VerticalAlignment="Bottom" LastChildFill="False">
                    <StackPanel x:Name="TitleActions" Orientation="Horizontal" Margin="-6,0,10,0"/>
                    <Button x:Name="ZoomButton" Style="{StaticResource Ed.SmallButton}" Click="Zoom_Click"
                            ToolTip="Zoom â€” pinch, Ctrl+scroll, Ctrl+plus / Ctrl+minus, Ctrl+0 fits, Ctrl+1 is 100%"/>
                    <TextBlock x:Name="SizeText" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource Ed.SecondaryBrush}" ToolTip="Image size"/>
                    <Button DockPanel.Dock="Right" x:Name="CopyButton" Style="{StaticResource Ed.PrimaryButton}" Margin="8,0,0,0"
                            Click="Copy_Click" ToolTip="Copy to the clipboard (Ctrl+Shift+C)"/>
                    <Button DockPanel.Dock="Right" x:Name="SaveButton" Style="{StaticResource Ed.SmallButton}" Margin="8,0,0,0"
                            Click="Save_Click" ToolTip="Save (Ctrl+S)"/>
                    <Button DockPanel.Dock="Right" x:Name="StackButton" Style="{StaticResource Ed.SmallButton}" Margin="8,0,0,0"
                            Click="Stack_Click" ToolTip="Keep in the bottom-right stack"/>
                    <Button DockPanel.Dock="Right" x:Name="DoneButton" Style="{StaticResource Ed.PlainButton}" Content="Done"
                            Click="Done_Click" ToolTip="Close the editor (Ctrl+W)"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
