<Window x:Class="BetterScreenshot.App.Recording.RecordStripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" ResizeMode="NoResize">
    <!-- v3 Part 4: the shared dark HUD card, 12 px radius, 1 px white 10 % border; padding 14 · 16 · 12 · 16. -->
    <Border x:Name="Card" CornerRadius="12" Background="{DynamicResource Hud.SurfaceBrush}"
            BorderBrush="#1AFFFFFF" BorderThickness="1" Margin="12" Padding="16,14,16,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45"/>
        </Border.Effect>
        <StackPanel x:Name="Stack" Width="932"/>
    </Border>
</Window>
