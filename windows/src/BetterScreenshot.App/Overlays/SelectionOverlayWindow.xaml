<Window x:Class="BetterScreenshot.App.Overlays.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Cursor="Cross" ShowActivated="True">
    <!-- Canvas background is 1/255 alpha: visually nothing, but keeps the whole window hit-testable
         (fully transparent pixels on a layered window pass clicks through to whatever is beneath). -->
    <Canvas x:Name="RootCanvas" Background="#01000000">
        <!-- Freeze mode only: this monitor's still, painted 1:1 under the dim so the screen appears frozen.
             Hidden (and the window stays transparent over the live screen) when freeze is off. -->
        <Image x:Name="FrozenImage" Stretch="Fill" Visibility="Collapsed"/>
        <!-- Dim with the live selection punched out (EvenOdd: full-monitor rect minus selection rect). -->
        <Path x:Name="DimPath" Fill="#59000000">
            <Path.Data>
                <GeometryGroup FillRule="EvenOdd">
                    <RectangleGeometry x:Name="FullRectGeometry"/>
                    <RectangleGeometry x:Name="SelectionGeometry"/>
                </GeometryGroup>
            </Path.Data>
        </Path>
        <Rectangle x:Name="SelRect" Stroke="White" StrokeThickness="1" Visibility="Collapsed"/>
        <Border x:Name="DimLabelHost" Background="#CC1C1C1C" CornerRadius="3" Padding="6,2" Visibility="Collapsed">
            <TextBlock x:Name="DimLabel" Foreground="White" FontSize="12" FontWeight="Medium"/>
        </Border>
    </Canvas>
</Window>
