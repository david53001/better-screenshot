<Window x:Class="BetterScreenshot.App.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History" Width="760" Height="540" MinWidth="660" MinHeight="360"
        WindowStartupLocation="Manual" Background="{StaticResource Theme.WindowBrush}">
    <!-- v3 §4.4: multi-select (Ctrl/Shift-click), multi-file drag-out, batch Copy / Show in Explorer / Delete,
         H1 min width 660 so no action truncates, H2 size/length under each cell, H3 an empty state that names the
         live Capture Area shortcut, H4 "Clear All History…" in the ⋯ menu instead of the action row. -->
    <DockPanel>
        <Border x:Name="ActionBar" DockPanel.Dock="Bottom" Background="{StaticResource Theme.ChromeBrush}" Padding="10,8">
            <DockPanel LastChildFill="False">
                <ContentPresenter x:Name="InfoSlot" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <Button x:Name="MoreButton" DockPanel.Dock="Right" Content="&#x22EF;" ToolTip="More"
                        AutomationProperties.Name="More" Click="More_Click" Padding="10,5" Margin="6,0,0,0"/>
                <TextBlock x:Name="CountLabel" DockPanel.Dock="Left" Foreground="{StaticResource Theme.SecondaryTextBrush}"
                           VerticalAlignment="Center" Margin="2,0,10,0"/>
                <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="Delete"
                        Style="{StaticResource Theme.DangerButton}" Click="Delete_Click" Padding="10,5" Margin="6,0,0,0"/>
                <Button x:Name="RevealButton" DockPanel.Dock="Right" Content="Show in Explorer"
                        Click="Reveal_Click" Padding="10,5" Margin="6,0,0,0"/>
                <Button x:Name="EditVideoButton" DockPanel.Dock="Right" Content="Edit Video…"
                        Click="EditVideo_Click" Padding="10,5" Margin="6,0,0,0"/>
                <Button x:Name="PinButton" DockPanel.Dock="Right" Content="Pin"
                        Click="Pin_Click" Padding="10,5" Margin="6,0,0,0"/>
                <Button x:Name="AnnotateButton" DockPanel.Dock="Right" Content="Annotate"
                        Click="Annotate_Click" Padding="10,5" Margin="6,0,0,0"/>
                <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copy"
                        Click="Copy_Click" Padding="10,5" Margin="6,0,0,0"/>
            </DockPanel>
        </Border>
        <Grid AutomationProperties.AutomationId="history.grid">
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                        MaxWidth="420">
                <TextBlock x:Name="EmptyTitle" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Theme.TextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyDetail" FontSize="13" Foreground="{StaticResource Theme.SecondaryTextBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="12">
                <!-- Centred as a block (rows stay left-aligned inside it): no empty band on one side at odd widths. -->
                <WrapPanel x:Name="CellsPanel" Orientation="Horizontal" Background="Transparent" HorizontalAlignment="Center"/>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
